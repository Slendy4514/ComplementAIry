{
  "name": "js-ts-base",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "node",

  "mounts": [
    "source=pnpm-store-${devcontainerId},target=/home/node/.local/share/pnpm/store,type=volume",
    "source=claude-config-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=aicode-perfil,target=/home/node/.cai,type=volume"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-vscode.vscode-typescript-next",
        "Anthropic.claude-code"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },

  "forwardPorts": [3000],
  "postCreateCommand": "sh .devcontainer/post-create.sh",
  "postAttachCommand": "[ -f packages/vscode-complementairy/complementairy.vsix ] && code --install-extension packages/vscode-complementairy/complementairy.vsix --force >/dev/null 2>&1 || true"
}
