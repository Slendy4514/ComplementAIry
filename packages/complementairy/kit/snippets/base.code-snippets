// Snippets base de ComplementAIry: estructuras muy conocidas y básicas.
// Se instalan en .vscode/cai-base.code-snippets: podés editarlos, borrarlos o agregar los tuyos
// (`cai snippet nuevo`). La IA solo puede SUGERIR snippets de esta biblioteca, nunca escribir código.
// Marcadores: ${1:nombre} se completa con `nombre=valor` al expandir (// @snippet: fn nombre=sumar args="a, b").
// Usa nombres de marcador simples (sin espacios) para poder pasarlos como argumento.
{
  "Función flecha": {
    "prefix": "fn",
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "description": "Función flecha con nombre",
    "body": ["const ${1:nombre} = (${2:args}) => {", "\t$0", "};"]
  },
  "Función flecha async": {
    "prefix": "fnasync",
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "description": "Función flecha asíncrona",
    "body": ["const ${1:nombre} = async (${2:args}) => {", "\t$0", "};"]
  },
  "Función exportada": {
    "prefix": "fnexport",
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "description": "Función con nombre, exportada",
    "body": ["export function ${1:nombre}(${2:args}) {", "\t$0", "}"]
  },
  "Try/catch": {
    "prefix": "try",
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "description": "Try/catch que relanza con un mensaje explicativo",
    "body": ["try {", "\t$0", "} catch (error) {", "\tthrow new Error(`${1:contexto}: \\${error instanceof Error ? error.message : String(error)}`);", "}"]
  },
  "Error explicativo": {
    "prefix": "error",
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "description": "Lanzar un error que explica qué valor falló",
    "body": ["throw new ${1|Error,TypeError,RangeError|}(`${2:esperado}, se recibió \\${${3:valor}}`);"]
  },
  "Test (vitest)": {
    "prefix": "test",
    "scope": "javascript,typescript",
    "description": "Caso de test con vitest",
    "body": ["test(\"${1:descripcion}\", () => {", "\texpect(${2:llamada}).toBe(${3:esperado});", "});"]
  },
  "Describe (vitest)": {
    "prefix": "describe",
    "scope": "javascript,typescript",
    "description": "Grupo de tests con vitest",
    "body": ["import { describe, expect, test } from \"vitest\";", "", "describe(\"${1:tema}\", () => {", "\ttest(\"${2:caso}\", () => {", "\t\t$0", "\t});", "});"]
  },
  "Ruta Express": {
    "prefix": "express-ruta",
    "scope": "javascript,typescript",
    "description": "Ruta de Express con manejo de errores",
    "body": [
      "${1:router}.${2:metodo}(\"${3:ruta}\", async (req, res, next) => {",
      "\ttry {",
      "\t\t$0",
      "\t\tres.json({ ok: true });",
      "\t} catch (error) {",
      "\t\tnext(error);",
      "\t}",
      "});"
    ]
  },
  "App Express": {
    "prefix": "express-app",
    "scope": "javascript,typescript",
    "description": "Servidor Express mínimo",
    "body": [
      "import express from \"express\";",
      "",
      "const app = express();",
      "app.use(express.json());",
      "",
      "$0",
      "",
      "const puerto = Number(process.env.PORT ?? ${1:3000});",
      "app.listen(puerto, () => console.log(`Escuchando en http://localhost:\\${puerto}`));"
    ]
  },
  "Clase": {
    "prefix": "clase",
    "scope": "javascript,typescript",
    "description": "Clase con constructor",
    "body": ["export class ${1:Nombre} {", "\tconstructor(${2:args}) {", "\t\t$0", "\t}", "}"]
  },
  "Importar (JS/TS)": {
    "prefix": "importar",
    "scope": "javascript,typescript,javascriptreact,typescriptreact",
    "description": "Importar nombres de un módulo",
    "body": ["import { ${1:nombres} } from \"${2:ruta}\";"]
  },
  "Vitest (imports)": {
    "prefix": "vitest",
    "scope": "javascript,typescript",
    "description": "Imports de vitest para un archivo de tests",
    "body": ["import { describe, expect, test } from \"vitest\";"]
  },
  "Test aproximado (vitest)": {
    "prefix": "test-aprox",
    "scope": "javascript,typescript",
    "description": "Caso de test para números con decimales (toBeCloseTo)",
    "body": ["test(\"${1:descripcion}\", () => {", "\texpect(${2:llamada}).toBeCloseTo(${3:esperado}, ${4:decimales});", "});"]
  },
  "Test de error (vitest)": {
    "prefix": "test-error",
    "scope": "javascript,typescript",
    "description": "Caso de test que espera un error",
    "body": ["test(\"${1:descripcion}\", () => {", "\texpect(() => ${2:llamada}).toThrow(${3:mensaje});", "});"]
  },
  "Python: importar": {
    "prefix": "importar",
    "scope": "python",
    "description": "Importar nombres de un módulo",
    "body": ["from ${1:modulo} import ${2:nombres}"]
  },
  "Python: test de error": {
    "prefix": "test-error",
    "scope": "python",
    "description": "Test de pytest que espera una excepción",
    "body": ["def test_${1:caso}():", "\twith pytest.raises(${3:Exception}):", "\t\t${2:llamada}"]
  },
  "Python: función": {
    "prefix": "def",
    "scope": "python",
    "description": "Función con docstring",
    "body": ["def ${1:nombre}(${2:args}):", "\t\"\"\"${3:descripcion}\"\"\"", "\t$0"]
  },
  "Python: test": {
    "prefix": "test",
    "scope": "python",
    "description": "Test de pytest",
    "body": ["def test_${1:caso}():", "\tassert ${2:llamada} == ${3:esperado}"]
  },
  "Python: main": {
    "prefix": "main",
    "scope": "python",
    "description": "Punto de entrada del script",
    "body": ["def main():", "\t$0", "", "", "if __name__ == \"__main__\":", "\tmain()"]
  }
}
